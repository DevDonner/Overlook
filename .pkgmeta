# BigWigs packager: what goes into the CurseForge zip.
package-as: Overlook

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .luacheckrc
  - .gitattributes
  - .gitignore
  - docs
  - tests
  - tools
  - sc_inputs
  - CHANGELOG.md
